# Tidemark — variables d'environnement (copier en .env ; .env est ignoré par Git, ne jamais le committer)

# Copernicus Data Space Ecosystem (https://dataspace.copernicus.eu) — OAuth2 client (Sentinel Hub / openEO)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Copernicus Data Space — accès S3 (optionnel, pour le téléchargement direct des produits)
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
CDSE_S3_ENDPOINT=https://eodata.dataspace.copernicus.eu

# NASA Earthdata (ICESat-2 ATL08, optionnel)
EARTHDATA_TOKEN=

# Cache local du pipeline (ignoré par Git)
ENVGRID_CACHE=.envgrid-cache
